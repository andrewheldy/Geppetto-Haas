{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanNode",
  "type": "object",
  "required": [
    "id",
    "objective",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "boolean"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parallelizable": {
      "type": "boolean"
    }
  }
}
