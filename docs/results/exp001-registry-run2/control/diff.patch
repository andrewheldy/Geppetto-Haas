+
+test("ingesting never mutates the agent definitions on disk", () => {
+  const root = twoRuns();
+  const file = join(root, "exp-1", "governed", "agents.json");
+  const before = readFileSync(file, "utf8");
+  const r = new SpecialistRegistry();
+  r.ingestRoot(root);
+  r.candidates();
+  assert.equal(readFileSync(file, "utf8"), before, "registry is read-only over runs");
+  assert.ok(!("promote" in SpecialistRegistry.prototype), "there is no auto-promotion path");
+});
+
+test("findRunDirs skips workspaces and non-run directories", () => {
+  const root = twoRuns();
+  mkdirSync(join(root, "exp-1", "governed", "workspace", "src"), { recursive: true });
+  writeFileSync(join(root, "exp-1", "governed", "workspace", "agents.json"), "[]");
+  mkdirSync(join(root, "exp-1", "notes"), { recursive: true });
+  const dirs = findRunDirs(root);
+  assert.equal(dirs.length, 2);
+  assert.ok(dirs.every((d) => !d.includes("workspace")));
+  assert.deepEqual(findRunDirs(join(root, "missing")), []);
