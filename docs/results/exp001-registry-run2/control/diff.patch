diff --git a/src/ledger-csv.ts b/src/ledger-csv.ts
new file mode 100644
index 0000000..cdd69a5
--- /dev/null
+++ b/src/ledger-csv.ts
@@ -0,0 +1,37 @@
+import type { ContextLedgerEntry } from "./types.ts";
+
+/**
+ * Column order of the exported CSV: every key of ContextLedgerEntry, in declaration order.
+ * The type guard below fails to compile if types.ts gains or renames a field.
+ */
+export const LEDGER_COLUMNS = [
+  "workflow_id", "mode", "node_id", "agent_id", "invocation_id", "model", "phase",
+  "available_context_tokens", "compiled_context_tokens", "hsc_tokens", "retrieved_tokens", "file_tokens",
+  "tool_tokens", "prompt_overhead_tokens", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens",
+  "active_context_tokens", "compacted_tokens_removed", "discarded_tokens", "retrievals", "compactions",
+  "hsc_delta_tokens", "estimated_cost_usd", "cost_estimated", "tokens_estimated", "duration_ms", "attempt", "ts",
+] as const satisfies ReadonlyArray<keyof ContextLedgerEntry>;
+
+/**
+ * Compile-time exhaustiveness: no key of ContextLedgerEntry may be missing from LEDGER_COLUMNS.
+ * The tuple wrapper stops the conditional from distributing, so `never` (= nothing missing) is the
+ * only shape that yields `true`. A plain `MissingColumns[] = []` would NOT catch this: the empty
+ * array is assignable to every array type.
+ */
+type MissingColumns = Exclude<keyof ContextLedgerEntry, (typeof LEDGER_COLUMNS)[number]>;
+const _noMissingColumns: [MissingColumns] extends [never] ? true : false = true;
+void _noMissingColumns;
+
+/** RFC4180 field: quote when the value contains a delimiter, quote or line break; inner quotes are doubled. */
+export function csvEscape(value: unknown): string {
+  if (value === undefined || value === null) return "";
+  const s = typeof value === "string" ? value : typeof value === "object" ? JSON.stringify(value) : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+}
+
+/** Render ledger rows as CSV. The header row is always emitted, even for an empty ledger. */
+export function ledgerToCsv(rows: ContextLedgerEntry[]): string {
+  const lines = [LEDGER_COLUMNS.map(csvEscape).join(",")];
+  for (const row of rows) lines.push(LEDGER_COLUMNS.map((c) => csvEscape(row[c])).join(","));
+  return lines.join("\n") + "\n";
+}
diff --git a/src/registry.ts b/src/registry.ts
new file mode 100644
index 0000000..4e6da3a
--- /dev/null
+++ b/src/registry.ts
@@ -0,0 +1,273 @@
+import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { basename, dirname, join, resolve } from "node:path";
+import type { AgentDefinition, ContextLedgerEntry, TraceEvent } from "./types.ts";
+
+/** A role is promotable only with enough evidence; both thresholds must hold. */
+export const PROMOTION_MIN_INVOCATIONS = 3;
+export const PROMOTION_MIN_SUCCESS_RATE = 0.8;
+
+/** agents.json is written without system_prompt, so only these fields are guaranteed. */
+export type RunAgent = Pick<AgentDefinition, "agent_id" | "role" | "node_id"> & Partial<AgentDefinition>;
+
+export interface RunData {
+  run_id: string;
+  dir?: string;
+  agents: RunAgent[];
+  ledger: ContextLedgerEntry[];
+  trace: TraceEvent[];
+}
+
+export interface RoleStats {
+  role: string;
+  /** Model invocations recorded in the ledger for agents carrying this role. */
+  invocations: number;
+  nodes_completed: number;
+  nodes_failed: number;
+  /** completed / (completed + failed); 0 when no node outcome was observed. */
+  success_rate: number;
+  mean_cost_usd: number;
+  mean_input_tokens: number;
+  mean_output_tokens: number;
+  total_cost_usd: number;
+  total_input_tokens: number;
+  total_output_tokens: number;
+  models: string[];
+  runs: string[];
+  first_seen: string;
+  last_seen: string;
+}
+
+export interface PromotionCandidate {
+  role: string;
+  invocations: number;
+  success_rate: number;
+  mean_cost_usd: number;
+  models: string[];
+  runs: number;
+  reason: string;
+}
+
+export interface RegistryFile {
+  version: number;
+  generated_at: string;
+  thresholds: { min_invocations: number; min_success_rate: number };
+  runs: string[];
+  roles: RoleStats[];
+  /** Suggestions only. Promotion is a human decision; agent definitions are never mutated. */
+  candidates: PromotionCandidate[];
+}
+
+const REGISTRY_VERSION = 1;
+const SKIP_DIRS = new Set(["workspace", "invocations", "node_modules", ".git"]);
+
+function readJsonl<T>(file: string): T[] {
+  if (!existsSync(file)) return [];
+  return readFileSync(file, "utf8").split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l) as T);
+}
+
+const num = (v: unknown): number => (typeof v === "number" && Number.isFinite(v) ? v : 0);
+const mean = (total: number, n: number): number => (n ? total / n : 0);
+const usd = (n: number): string => `$${n.toFixed(4)}`;
+const pct = (n: number): string => `${(n * 100).toFixed(0)}%`;
+const int = (n: number): string => Math.round(n).toLocaleString("en-US");
+
+/**
+ * Aggregates per-role telemetry across run directories and suggests specialists worth promoting
+ * from ephemeral to registered. It only ever reports candidates: nothing is promoted automatically
+ * and no agent definition is modified.
+ */
+export class SpecialistRegistry {
+  private readonly stats = new Map<string, RoleStats>();
+  private readonly ingested = new Set<string>();
+
+  /** Run ids already folded into this registry. */
+  get runs(): string[] { return [...this.ingested].sort(); }
+
+  /** Fold one run's telemetry in. Ingesting the same run id twice is a no-op. */
+  ingest(run: RunData): boolean {
+    if (this.ingested.has(run.run_id)) return false;
+    this.ingested.add(run.run_id);
+
+    const roleByAgent = new Map<string, string>();
+    const roleByNode = new Map<string, string>();
+    for (const a of run.agents) {
+      if (!a?.agent_id || !a.role) continue;
+      roleByAgent.set(a.agent_id, a.role);
+      if (a.node_id) roleByNode.set(a.node_id, a.role);
+    }
+
+    for (const row of run.ledger) {
+      const role = roleByAgent.get(row.agent_id) ?? (row.node_id ? roleByNode.get(row.node_id) : undefined);
+      if (!role) continue; // deterministic rows (test-runner) have no specialist behind them
+      const s = this.bucket(role);
+      s.invocations++;
+      s.total_cost_usd += num(row.estimated_cost_usd);
+      s.total_input_tokens += num(row.input_tokens);
+      s.total_output_tokens += num(row.output_tokens);
+      if (row.model && row.model !== "none" && !s.models.includes(row.model)) s.models.push(row.model);
+      if (!s.runs.includes(run.run_id)) s.runs.push(run.run_id);
+      if (row.ts) {
+        if (!s.first_seen || row.ts < s.first_seen) s.first_seen = row.ts;
+        if (!s.last_seen || row.ts > s.last_seen) s.last_seen = row.ts;
+      }
+    }
+
+    for (const ev of run.trace) {
+      if (ev.type !== "node.completed" && ev.type !== "node.failed") continue;
+      const role = ev.agent_id ? roleByAgent.get(ev.agent_id) : undefined;
+      const resolved = role ?? (ev.node_id ? roleByNode.get(ev.node_id) : undefined);
+      if (!resolved) continue;
+      const s = this.bucket(resolved);
+      if (ev.type === "node.completed") s.nodes_completed++; else s.nodes_failed++;
+      if (!s.runs.includes(run.run_id)) s.runs.push(run.run_id);
+    }
+
+    for (const s of this.stats.values()) this.finalize(s);
+    return true;
+  }
+
+  /** Read agents.json / ledger.jsonl / trace.jsonl from a single run directory. */
+  ingestRunDir(dir: string): boolean {
+    const d = resolve(dir);
+    const agentsFile = join(d, "agents.json");
+    if (!existsSync(agentsFile)) throw new Error(`not a run directory (no agents.json): ${dir}`);
+    const agents = JSON.parse(readFileSync(agentsFile, "utf8")) as RunAgent[];
+    const ledger = readJsonl<ContextLedgerEntry>(join(d, "ledger.jsonl"));
+    const trace = readJsonl<TraceEvent>(join(d, "trace.jsonl"));
+    const run_id = ledger[0]?.workflow_id ?? trace[0]?.workflow_id ?? `${basename(dirname(d))}/${basename(d)}`;
+    return this.ingest({ run_id, dir: d, agents: Array.isArray(agents) ? agents : [], ledger, trace });
+  }
+
+  /** Ingest every run directory found under `root` (the root itself counts when it holds agents.json). */
+  ingestRoot(root: string, maxDepth = 4): string[] {
+    const dirs = findRunDirs(root, maxDepth);
+    for (const d of dirs) this.ingestRunDir(d);
+    return dirs;
+  }
+
+  /** Per-role statistics, busiest role first. */
+  roles(): RoleStats[] {
+    return [...this.stats.values()]
+      .map((s) => ({ ...s, models: [...s.models].sort(), runs: [...s.runs] }))
+      .sort((a, b) => b.invocations - a.invocations || a.role.localeCompare(b.role));
+  }
+
+  /**
+   * Roles that clear both thresholds. These are suggestions for a human to review;
+   * nothing is promoted and no agent definition changes.
+   */
+  candidates(): PromotionCandidate[] {
+    return this.roles()
+      .filter((s) => s.invocations >= PROMOTION_MIN_INVOCATIONS && s.success_rate >= PROMOTION_MIN_SUCCESS_RATE)
+      .map((s) => ({
+        role: s.role,
+        invocations: s.invocations,
+        success_rate: s.success_rate,
+        mean_cost_usd: s.mean_cost_usd,
+        models: s.models,
+        runs: s.runs.length,
+        reason: reasonFor(s),
+      }));
+  }
+
+  toJSON(): RegistryFile {
+    return {
+      version: REGISTRY_VERSION,
+      generated_at: new Date().toISOString(),
+      thresholds: { min_invocations: PROMOTION_MIN_INVOCATIONS, min_success_rate: PROMOTION_MIN_SUCCESS_RATE },
+      runs: this.runs,
+      roles: this.roles(),
+      candidates: this.candidates(),
+    };
+  }
+
+  save(file: string): RegistryFile {
+    const data = this.toJSON();
+    mkdirSync(dirname(resolve(file)), { recursive: true });
+    writeFileSync(file, JSON.stringify(data, null, 2) + "\n");
+    return data;
+  }
+
+  static fromJSON(data: RegistryFile): SpecialistRegistry {
+    const r = new SpecialistRegistry();
+    for (const run of data.runs ?? []) r.ingested.add(run);
+    for (const role of data.roles ?? []) r.stats.set(role.role, r.finalize({ ...role, models: [...role.models], runs: [...role.runs] }));
+    return r;
+  }
+
+  static load(file: string): SpecialistRegistry {
+    return SpecialistRegistry.fromJSON(JSON.parse(readFileSync(file, "utf8")) as RegistryFile);
+  }
+
+  /** Human-readable table: one row per role, plus the promotion suggestions. */
+  renderTable(): string {
+    const rows = this.roles();
+    const head = ["role", "invocations", "success", "mean $", "mean in", "mean out", "runs", "models"];
+    const body = rows.map((s) => [
+      s.role, String(s.invocations), s.nodes_completed + s.nodes_failed ? pct(s.success_rate) : "—",
+      usd(s.mean_cost_usd), int(s.mean_input_tokens), int(s.mean_output_tokens), String(s.runs.length), s.models.join(",") || "—",
+    ]);
+    const widths = head.map((h, i) => Math.max(h.length, ...body.map((r) => r[i]!.length), 3));
+    const line = (cells: string[]) => cells.map((c, i) => (i === 0 || i === head.length - 1 ? c.padEnd(widths[i]!) : c.padStart(widths[i]!))).join("  ").trimEnd();
+    const out = [
+      `specialist registry — ${rows.length} role(s) across ${this.runs.length} run(s)`,
+      line(head), widths.map((w) => "─".repeat(w)).join("  "),
+      ...body.map(line),
+    ];
+    const cands = this.candidates();
+    out.push("", `promotion candidates (>=${PROMOTION_MIN_INVOCATIONS} invocations, >=${pct(PROMOTION_MIN_SUCCESS_RATE)} success) — suggestions only, nothing was promoted:`);
+    if (!cands.length) out.push("  (none yet)");
+    for (const c of cands) out.push(`  • ${c.role}: ${c.reason}`);
+    return out.join("\n");
+  }
+
+  private bucket(role: string): RoleStats {
+    let s = this.stats.get(role);
+    if (!s) {
+      s = {
+        role, invocations: 0, nodes_completed: 0, nodes_failed: 0, success_rate: 0,
+        mean_cost_usd: 0, mean_input_tokens: 0, mean_output_tokens: 0,
+        total_cost_usd: 0, total_input_tokens: 0, total_output_tokens: 0,
+        models: [], runs: [], first_seen: "", last_seen: "",
+      };
+      this.stats.set(role, s);
+    }
+    return s;
+  }
+
+  private finalize(s: RoleStats): RoleStats {
+    const outcomes = s.nodes_completed + s.nodes_failed;
+    s.success_rate = outcomes ? s.nodes_completed / outcomes : 0;
+    s.mean_cost_usd = mean(s.total_cost_usd, s.invocations);
+    s.mean_input_tokens = mean(s.total_input_tokens, s.invocations);
+    s.mean_output_tokens = mean(s.total_output_tokens, s.invocations);
+    return s;
+  }
+}
+
+function reasonFor(s: RoleStats): string {
+  return `${s.invocations} invocations across ${s.runs.length} run(s), ` +
+    `${s.nodes_completed}/${s.nodes_completed + s.nodes_failed} nodes succeeded (${pct(s.success_rate)}), ` +
+    `mean ${usd(s.mean_cost_usd)} and ${int(s.mean_input_tokens)} in / ${int(s.mean_output_tokens)} out tokens ` +
+    `on ${s.models.join(", ") || "unknown model"}. ` +
+    `Clears the promotion bar (>=${PROMOTION_MIN_INVOCATIONS} invocations, >=${pct(PROMOTION_MIN_SUCCESS_RATE)} success), ` +
+    `so this role looks worth registering as a reusable specialist — suggestion only, requires human approval.`;
+}
+
+/** Depth-bounded scan for directories containing agents.json. */
+export function findRunDirs(root: string, maxDepth = 4): string[] {
+  const start = resolve(root);
+  const found: string[] = [];
+  const walk = (dir: string, depth: number): void => {
+    if (existsSync(join(dir, "agents.json"))) found.push(dir);
+    if (depth >= maxDepth) return;
+    let entries;
+    try { entries = readdirSync(dir, { withFileTypes: true }); } catch { return; }
+    for (const e of entries) {
+      if (!e.isDirectory() || SKIP_DIRS.has(e.name) || e.name.startsWith(".")) continue;
+      walk(join(dir, e.name), depth + 1);
+    }
+  };
+  if (existsSync(start)) walk(start, 0);
+  return found.sort();
+}
diff --git a/tests/ledger-csv.test.ts b/tests/ledger-csv.test.ts
new file mode 100644
index 0000000..b46fe0e
--- /dev/null
+++ b/tests/ledger-csv.test.ts
@@ -0,0 +1,118 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { LEDGER_COLUMNS, csvEscape, ledgerToCsv } from "../src/ledger-csv.ts";
+import { Orchestrator } from "../src/orchestrator.ts";
+import { DeterministicPlanner } from "../src/planner.ts";
+import { DeterministicRouter } from "../src/router.ts";
+import { MockRuntime } from "../src/runtime.ts";
+import { fakeRepo, task, tmp } from "./helpers.ts";
+import type { ContextLedgerEntry } from "../src/types.ts";
+
+function row(over: Partial<ContextLedgerEntry> = {}): ContextLedgerEntry {
+  return {
+    workflow_id: "w1", mode: "governed", node_id: "implement", agent_id: "implementer-01", invocation_id: "inv-1",
+    model: "sonnet", phase: "implement", available_context_tokens: 1000, compiled_context_tokens: 400, hsc_tokens: 50,
+    retrieved_tokens: 20, file_tokens: 100, tool_tokens: 30, prompt_overhead_tokens: 10, input_tokens: 900,
+    output_tokens: 120, cache_read_tokens: 5, cache_write_tokens: 6, active_context_tokens: 911,
+    compacted_tokens_removed: 7, discarded_tokens: 600, retrievals: 1, compactions: 2, hsc_delta_tokens: 3,
+    estimated_cost_usd: 0.0123, cost_estimated: true, tokens_estimated: false, duration_ms: 1500, attempt: 1,
+    ts: "2026-01-01T00:00:00.000Z", ...over,
+  };
+}
+
+const lines = (csv: string) => csv.split("\n").filter((l) => l !== "");
+
+test("header row lists every ContextLedgerEntry key", () => {
+  const csv = ledgerToCsv([]);
+  const header = csv.split("\n")[0]!.split(",");
+  assert.deepEqual(header, [...LEDGER_COLUMNS]);
+  const keys = Object.keys(row());
+  assert.deepEqual([...header].sort(), keys.sort(), "header must match the runtime keys of a ledger entry");
+});
+
+test("empty ledger still produces the header and nothing else", () => {
+  const csv = ledgerToCsv([]);
+  assert.equal(lines(csv).length, 1);
+  assert.ok(csv.endsWith("\n"));
+});
+
+test("one row per ledger entry, values in column order", () => {
+  const csv = ledgerToCsv([row(), row({ node_id: "review", input_tokens: 42 })]);
+  const out = lines(csv);
+  assert.equal(out.length, 3);
+  const cells = out[1]!.split(",");
+  assert.equal(cells[LEDGER_COLUMNS.indexOf("node_id")], "implement");
+  assert.equal(cells[LEDGER_COLUMNS.indexOf("input_tokens")], "900");
+  assert.equal(out[2]!.split(",")[LEDGER_COLUMNS.indexOf("input_tokens")], "42");
+});
+
+test("numbers and booleans render without quotes", () => {
+  const cells = lines(ledgerToCsv([row()]))[1]!.split(",");
+  assert.equal(cells[LEDGER_COLUMNS.indexOf("estimated_cost_usd")], "0.0123");
+  assert.equal(cells[LEDGER_COLUMNS.indexOf("cost_estimated")], "true");
+  assert.equal(cells[LEDGER_COLUMNS.indexOf("tokens_estimated")], "false");
+});
+
+test("commas, quotes and newlines are escaped RFC4180-style", () => {
+  assert.equal(csvEscape("plain"), "plain");
+  assert.equal(csvEscape("a,b"), '"a,b"');
+  assert.equal(csvEscape('say "hi"'), '"say ""hi"""');
+  assert.equal(csvEscape("line1\nline2"), '"line1\nline2"');
+  assert.equal(csvEscape("cr\r\nlf"), '"cr\r\nlf"');
+  assert.equal(csvEscape(undefined), "");
+  assert.equal(csvEscape(null), "");
+  assert.equal(csvEscape(0), "0");
+});
+
+test("escaped fields survive a round-trip parse", () => {
+  const nasty = ledgerToCsv([row({ node_id: 'a,b', phase: 'he said "go"', agent_id: "multi\nline" })]);
+  const parsed = parseCsv(nasty);
+  assert.equal(parsed.length, 2);
+  assert.equal(parsed[1]![LEDGER_COLUMNS.indexOf("node_id")], "a,b");
+  assert.equal(parsed[1]![LEDGER_COLUMNS.indexOf("phase")], 'he said "go"');
+  assert.equal(parsed[1]![LEDGER_COLUMNS.indexOf("agent_id")], "multi\nline");
+  assert.equal(parsed[1]!.length, LEDGER_COLUMNS.length, "embedded separators must not create extra columns");
+});
+
+test("exports a real ledger.jsonl: every written row and key is covered", async () => {
+  const out = tmp();
+  const runtime = new MockRuntime({ write_on_implement: { "src/widget.ts": "export const w = 1;" } });
+  await new Orchestrator({
+    task: task(), workflow_id: "csv-1", runtime, planner: new DeterministicPlanner(),
+    router: new DeterministicRouter(), workspace: fakeRepo(), out_dir: out,
+  }).run();
+
+  const written: ContextLedgerEntry[] = readFileSync(join(out, "ledger.jsonl"), "utf8")
+    .split("\n").filter(Boolean).map((l) => JSON.parse(l));
+  assert.ok(written.length > 0);
+  for (const row of written) {
+    assert.deepEqual(Object.keys(row).sort(), [...LEDGER_COLUMNS].sort(), "no ledger key is missing from the CSV header");
+  }
+
+  const parsed = parseCsv(ledgerToCsv(written));
+  assert.equal(parsed.length, written.length + 1, "header + one line per row");
+  for (const line of parsed) assert.equal(line.length, LEDGER_COLUMNS.length);
+  assert.equal(parsed[1]![LEDGER_COLUMNS.indexOf("workflow_id")], "csv-1");
+});
+
+/** Minimal RFC4180 reader used to prove the writer's escaping is correct. */
+function parseCsv(text: string): string[][] {
+  const rows: string[][] = [];
+  let row: string[] = [], field = "", quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i]!;
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else field += c;
+    } else if (c === '"') quoted = true;
+    else if (c === ",") { row.push(field); field = ""; }
+    else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
+    else if (c === "\r") continue;
+    else field += c;
+  }
+  if (field || row.length) { row.push(field); rows.push(row); }
+  return rows;
+}
