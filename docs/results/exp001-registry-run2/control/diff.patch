+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+const CLI = join(import.meta.dirname, "..", "src", "cli.ts");
+import { SpecialistRegistry, findRunDirs, PROMOTION_MIN_INVOCATIONS, PROMOTION_MIN_SUCCESS_RATE, type RunAgent } from "../src/registry.ts";
+import { Orchestrator } from "../src/orchestrator.ts";
+import { DeterministicPlanner } from "../src/planner.ts";
+import { DeterministicRouter } from "../src/router.ts";
+import { MockRuntime } from "../src/runtime.ts";
+import { fakeRepo, task, tmp } from "./helpers.ts";
+import type { ContextLedgerEntry, TraceEvent } from "../src/types.ts";
+
+interface Spec { node: string; role: string; model?: string; cost?: number; input?: number; output?: number; outcome?: "completed" | "failed" }
+
+/** Write a run directory shaped exactly like the orchestrator's output. */
+function writeRun(dir: string, workflow_id: string, specs: Spec[]): string {
+  mkdirSync(dir, { recursive: true });
+  const agents: RunAgent[] = [];
+  const ledger: ContextLedgerEntry[] = [];
+  const trace: TraceEvent[] = [];
+  specs.forEach((s, i) => {
+    const agent_id = `${s.role.toLowerCase().replace(/\s+/g, "-")}-${workflow_id}-${i}`;
+    agents.push({ agent_id, role: s.role, node_id: s.node });
+    ledger.push({
+      workflow_id, mode: "governed", node_id: s.node, agent_id, invocation_id: `inv-${workflow_id}-${i}`,
+      model: s.model ?? "sonnet", phase: s.node, available_context_tokens: 1000, compiled_context_tokens: 300,
+      hsc_tokens: 10, retrieved_tokens: 0, file_tokens: 20, tool_tokens: 0, prompt_overhead_tokens: 5,
+      input_tokens: s.input ?? 100, output_tokens: s.output ?? 10, cache_read_tokens: 0, cache_write_tokens: 0,
+      active_context_tokens: 500, compacted_tokens_removed: 0, discarded_tokens: 700, retrievals: 0, compactions: 0,
+      hsc_delta_tokens: 0, estimated_cost_usd: s.cost ?? 0.01, cost_estimated: true, tokens_estimated: false,
+      duration_ms: 100, attempt: 1, ts: `2026-01-0${i + 1}T00:00:00.000Z`,
+    });
+    trace.push({
+      ts: `2026-01-0${i + 1}T00:00:01.000Z`, seq: i, type: `node.${s.outcome ?? "completed"}`,
+      workflow_id, mode: "governed", node_id: s.node, agent_id, data: {},
+    });
+  });
+  // a deterministic test-runner row: no specialist behind it, must be ignored
+  ledger.push({ ...ledger[0]!, agent_id: "test-runner", node_id: "test", model: "none", invocation_id: `tool-${workflow_id}`, estimated_cost_usd: 0, input_tokens: 0, output_tokens: 0 });
+  writeFileSync(join(dir, "agents.json"), JSON.stringify(agents, null, 2));
+  writeFileSync(join(dir, "ledger.jsonl"), ledger.map((e) => JSON.stringify(e)).join("\n") + "\n");
+  writeFileSync(join(dir, "trace.jsonl"), trace.map((e) => JSON.stringify(e)).join("\n") + "\n");
+  return dir;
+}
+
+function ledgerRow(workflow_id: string, agent_id: string, node_id: string, i: number, over: Partial<ContextLedgerEntry> = {}): ContextLedgerEntry {
+  return {
+    workflow_id, mode: "governed", node_id, agent_id, invocation_id: `inv-${i}`, model: "sonnet", phase: node_id,
+    available_context_tokens: 1000, compiled_context_tokens: 300, hsc_tokens: 0, retrieved_tokens: 0, file_tokens: 0,
+    tool_tokens: 0, prompt_overhead_tokens: 0, input_tokens: 100, output_tokens: 10, cache_read_tokens: 0,
+    cache_write_tokens: 0, active_context_tokens: 400, compacted_tokens_removed: 0, discarded_tokens: 0,
+    retrievals: 0, compactions: 0, hsc_delta_tokens: 0, estimated_cost_usd: 0.01, cost_estimated: true,
+    tokens_estimated: false, duration_ms: 10, attempt: 1, ts: `2026-02-0${i + 1}T00:00:00.000Z`, ...over,
+  };
+}
+
+function traceEv(type: string, node_id: string, seq: number): TraceEvent {
+  return { ts: `2026-02-0${seq + 1}T00:00:00.000Z`, seq, type, workflow_id: "w", mode: "governed", node_id, data: {} };
+}
+
+function twoRuns(): string {
+  const root = tmp();
+  writeRun(join(root, "exp-1", "governed"), "w1", [
+    { node: "implement", role: "Implementer", cost: 0.02, input: 200, output: 20 },
+    { node: "review", role: "Reviewer", cost: 0.01, input: 100, output: 10 },
+  ]);
+  writeRun(join(root, "exp-2", "governed"), "w2", [
+    { node: "implement", role: "Implementer", cost: 0.04, input: 400, output: 40, model: "opus" },
+    { node: "implement", role: "Implementer", cost: 0.06, input: 600, output: 60 },
+    { node: "review", role: "Reviewer", cost: 0.03, input: 300, output: 30, outcome: "failed" },
+  ]);
+  return root;
+}
+
+test("aggregates per-role stats across several run directories", () => {
+  const root = twoRuns();
+  const r = new SpecialistRegistry();
+  const dirs = r.ingestRoot(root);
+  assert.equal(dirs.length, 2, "found both run dirs");
+  assert.deepEqual(r.runs, ["w1", "w2"]);
+
+  const impl = r.roles().find((s) => s.role === "Implementer")!;
+  assert.equal(impl.invocations, 3);
+  assert.equal(impl.nodes_completed, 3);
+  assert.equal(impl.nodes_failed, 0);
+  assert.equal(impl.success_rate, 1);
+  assert.ok(Math.abs(impl.mean_cost_usd - 0.04) < 1e-9, `mean cost ${impl.mean_cost_usd}`);
+  assert.equal(impl.mean_input_tokens, 400);
+  assert.equal(impl.mean_output_tokens, 40);
+  assert.deepEqual(impl.models, ["opus", "sonnet"]);
+  assert.deepEqual(impl.runs, ["w1", "w2"]);
+  assert.equal(impl.first_seen, "2026-01-01T00:00:00.000Z");
+
+  const rev = r.roles().find((s) => s.role === "Reviewer")!;
+  assert.equal(rev.invocations, 2);
+  assert.equal(rev.success_rate, 0.5, "one completed, one failed");
+  assert.equal(r.roles()[0]!.role, "Implementer", "busiest role first");
+});
+
+test("deterministic ledger rows without a specialist are ignored", () => {
+  const r = new SpecialistRegistry();
+  r.ingestRunDir(writeRun(join(tmp(), "run"), "w1", [{ node: "implement", role: "Implementer" }]));
+  assert.equal(r.roles().length, 1);
+  assert.equal(r.roles()[0]!.invocations, 1, "the test-runner row is not counted");
+});
+
+test("success rate comes from node.completed vs node.failed trace events", () => {
+  const r = new SpecialistRegistry();
+  r.ingest({
+    run_id: "w", agents: [{ agent_id: "a1", role: "Implementer", node_id: "implement" }],
+    ledger: [],
+    trace: [
+      { ts: "t", seq: 0, type: "node.failed", workflow_id: "w", mode: "governed", node_id: "implement", data: {} },
+      { ts: "t", seq: 1, type: "node.completed", workflow_id: "w", mode: "governed", node_id: "implement", data: {} },
+      { ts: "t", seq: 2, type: "node.started", workflow_id: "w", mode: "governed", node_id: "implement", data: {} },
+    ],
+  });
+  const s = r.roles()[0]!;
+  assert.equal(s.nodes_completed, 1);
+  assert.equal(s.nodes_failed, 1);
+  assert.equal(s.success_rate, 0.5, "node.started is not an outcome");
+});
+
+test("promotion candidates need >=3 invocations and >=0.8 success, with a readable reason", () => {
+  assert.equal(PROMOTION_MIN_INVOCATIONS, 3);
+  assert.equal(PROMOTION_MIN_SUCCESS_RATE, 0.8);
+  const r = new SpecialistRegistry();
+  r.ingestRoot(twoRuns());
+  const names = r.candidates().map((c) => c.role);
+  assert.deepEqual(names, ["Implementer"], "Reviewer has 2 invocations at 50% success");
+
+  const c = r.candidates()[0]!;
+  assert.equal(c.invocations, 3);
+  assert.equal(c.success_rate, 1);
+  assert.equal(c.runs, 2);
+  assert.match(c.reason, /3 invocations across 2 run\(s\)/);
+  assert.match(c.reason, /100%/);
+  assert.match(c.reason, /\$0\.0400/);
+  assert.match(c.reason, /suggestion only/i);
+});
+
+test("thresholds are boundaries: exactly 3 invocations at exactly 0.8 promotes, 2 invocations does not", () => {
+  const atBar = new SpecialistRegistry();
+  atBar.ingest({
+    run_id: "w", agents: [{ agent_id: "a1", role: "Coder", node_id: "n1" }],
+    ledger: Array.from({ length: 3 }, (_, i) => ledgerRow("w", "a1", "n1", i)),
+    trace: [...Array.from({ length: 4 }, (_, i) => traceEv("node.completed", "n1", i)), traceEv("node.failed", "n1", 4)],
+  });
+  assert.equal(atBar.roles()[0]!.success_rate, 0.8);
+  assert.deepEqual(atBar.candidates().map((c) => c.role), ["Coder"]);
+
+  const tooFew = new SpecialistRegistry();
+  tooFew.ingest({
+    run_id: "w", agents: [{ agent_id: "a1", role: "Coder", node_id: "n1" }],
+    ledger: [ledgerRow("w", "a1", "n1", 0), ledgerRow("w", "a1", "n1", 1)],
+    trace: [traceEv("node.completed", "n1", 0), traceEv("node.completed", "n1", 1)],
+  });
+  assert.equal(tooFew.roles()[0]!.success_rate, 1);
+  assert.deepEqual(tooFew.candidates(), [], "perfect success is not enough without evidence volume");
+
+  const belowBar = new SpecialistRegistry();
+  belowBar.ingest({
+    run_id: "w", agents: [{ agent_id: "a1", role: "Coder", node_id: "n1" }],
+    ledger: Array.from({ length: 4 }, (_, i) => ledgerRow("w", "a1", "n1", i)),
+    trace: [...Array.from({ length: 3 }, (_, i) => traceEv("node.completed", "n1", i)), traceEv("node.failed", "n1", 3)],
+  });
+  assert.equal(belowBar.roles()[0]!.success_rate, 0.75);
+  assert.deepEqual(belowBar.candidates(), [], "0.75 < 0.8");
+});
+
+test("a role with invocations but no observed outcome is never a candidate", () => {
+  const r = new SpecialistRegistry();
+  r.ingest({
+    run_id: "w", agents: [{ agent_id: "a1", role: "Coder", node_id: "n1" }],
+    ledger: Array.from({ length: 5 }, (_, i) => ledgerRow("w", "a1", "n1", i)), trace: [],
+  });
+  assert.equal(r.roles()[0]!.success_rate, 0);
+  assert.deepEqual(r.candidates(), []);
+});
+
+test("save/load round-trips through registry.json without changing stats or candidates", () => {
+  const r = new SpecialistRegistry();
+  r.ingestRoot(twoRuns());
+  const file = join(tmp(), "nested", "registry.json");
+  const saved = r.save(file);
+  assert.equal(saved.version, 1);
+  assert.deepEqual(saved.thresholds, { min_invocations: 3, min_success_rate: 0.8 });
