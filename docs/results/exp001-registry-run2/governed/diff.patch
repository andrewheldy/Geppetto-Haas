+test("findRunDirs skips non-run directories and recurses into experiment layouts", () => {
+  const root = tmp();
+  mkdirSync(join(root, "exp1"), { recursive: true });
+  runDir(join(root, "exp1"), "governed", { agents: [{ agent_id: "a1", role: "Specialist", node_id: "n1" }] });
+  mkdirSync(join(root, "exp1", "control"), { recursive: true });        // control run: no agents.json
+  writeFileSync(join(root, "exp1", "control", "summary.json"), "{}");
+  mkdirSync(join(root, "exp1", "governed", "workspace"), { recursive: true });
+  writeFileSync(join(root, "exp1", "governed", "workspace", "agents.json"), "[]"); // must be skipped
+  const found = SpecialistRegistry.findRunDirs(root);
+  assert.deepEqual(found, [join(root, "exp1", "governed")]);
+  assert.deepEqual(SpecialistRegistry.findRunDirs(join(root, "nope")), []);
