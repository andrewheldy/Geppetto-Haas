+test("registry never mutates run artifacts", () => {
+  const root = twoRuns();
+  const agentsFile = join(root, "run-a", "agents.json");
+  const before = readFileSync(agentsFile);
+  const reg = new SpecialistRegistry();
+  reg.ingestRuns(SpecialistRegistry.findRunDirs(root));
+  reg.candidates();
+  reg.table();
+  assert.deepEqual(readFileSync(agentsFile), before, "agents.json byte-identical after ingest");
+});
