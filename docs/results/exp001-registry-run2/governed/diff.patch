+test("save/load round-trips losslessly and keeps accumulating", () => {
+  const root = twoRuns();
+  const reg = new SpecialistRegistry();
+  reg.ingestRun(join(root, "run-a"));
+  const file = join(tmp(), "nested", "registry.json");
+  const saved = reg.save(file);
+  const loaded = SpecialistRegistry.load(file);
+  assert.deepEqual(loaded.roles(), reg.roles());
+  assert.deepEqual(loaded.candidates(), reg.candidates());
+  assert.deepEqual(JSON.parse(readFileSync(file, "utf8")).roles, saved.roles);
+
+  loaded.ingestRun(join(root, "run-b"));
+  const full = new SpecialistRegistry();
+  full.ingestRuns([join(root, "run-a"), join(root, "run-b")]);
+  assert.deepEqual(loaded.roles(), full.roles());
+});
+
+test("ingesting the same run twice does not double-count", () => {
+  const root = twoRuns();
+  const reg = new SpecialistRegistry();
+  reg.ingestRun(join(root, "run-a"));
+  reg.ingestRun(join(root, "run-a"));
+  assert.equal(reg.roles().find((r) => r.role === "Planning Architect")!.invocations, 2);
+});
