+test("table renders roles and a candidate section", () => {
+  const root = twoRuns();
+  const reg = new SpecialistRegistry();
+  reg.ingestRuns(SpecialistRegistry.findRunDirs(root));
+  const t = reg.table();
+  assert.match(t, /role\s+invocations\s+success/);
+  assert.match(t, /Planning Architect\s+4\s+100%/);
+  assert.match(t, /Promotion candidates \(suggestions only/);
+  assert.match(t, /- Planning Architect: 4 invocations/);
+  assert.match(new SpecialistRegistry().table(), /\(no roles ingested\)[\s\S]*\(none\)/);
+});
