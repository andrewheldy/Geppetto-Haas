+test("candidates need >=3 invocations and >=0.8 success, and are suggestions only", () => {
+  const root = twoRuns();
+  const reg = new SpecialistRegistry();
+  reg.ingestRuns(SpecialistRegistry.findRunDirs(root));
+  const cands = reg.candidates();
+  assert.deepEqual(cands.map((c) => c.role), ["Planning Architect"]);
+  assert.equal(cands[0].status, "candidate");
+  assert.equal(cands[0].invocations, 4);
+  assert.match(cands[0].reason, /Planning Architect: 4 invocations, 100% node success \(3\/3\)/);
+  assert.match(cands[0].reason, /mean \$0\.0200 \/ 1,200 in \/ 300 out tokens on haiku\+sonnet/);
+  assert.match(cands[0].reason, /human approval required/);
+  assert.equal(SpecialistRegistry.MIN_INVOCATIONS, 3);
+  assert.equal(SpecialistRegistry.MIN_SUCCESS_RATE, 0.8);
+});
