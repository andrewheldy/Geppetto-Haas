+test("ingests a real orchestrator run directory", async () => {
+  const out = tmp();
+  const runtime = new MockRuntime({ write_on_implement: { "src/widget.ts": "export const w = 1;" } });
+  await new Orchestrator({
+    task: task(), workflow_id: "w", runtime, planner: new DeterministicPlanner(),
+    router: new DeterministicRouter(), workspace: fakeRepo(), out_dir: out,
+  }).run();
+  const reg = new SpecialistRegistry();
+  assert.deepEqual(SpecialistRegistry.findRunDirs(out), [out]);
+  reg.ingestRun(out);
+  const roles = reg.roles();
+  assert.deepEqual(roles.map((r) => r.role).sort(), ["Implementation Engineer", "Independent Reviewer", "Planning Architect"]);
+  assert.equal(roles.reduce((a, r) => a + r.invocations, 0), 3, "3 agent invocations, test runner excluded");
+  for (const r of roles) {
+    assert.equal(r.success_rate, 1);
+    assert.ok(r.mean_input_tokens > 0 && r.mean_output_tokens > 0);
+    assert.ok(r.models.length && !r.models.includes("none"));
+  }
+  assert.deepEqual(reg.candidates(), [], "one invocation per role is below the promotion threshold");
